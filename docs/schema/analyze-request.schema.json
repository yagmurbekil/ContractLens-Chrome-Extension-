{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "documentTypeHint": {
      "type": "string",
      "enum": [
        "terms_of_service",
        "privacy_policy",
        "subscription_terms",
        "cookie_policy",
        "refund_policy",
        "data_processing",
        "eula",
        "other_legal",
        "not_legal",
        "unknown"
      ]
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "chunks": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c\\d{1,4}$"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "heading",
          "text",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "url",
    "title",
    "documentTypeHint",
    "language",
    "chunks"
  ],
  "additionalProperties": false
}