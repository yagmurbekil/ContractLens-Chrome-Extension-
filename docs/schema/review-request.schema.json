{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "documentTypeHint": {
      "type": "string",
      "enum": [
        "terms_of_service",
        "privacy_policy",
        "subscription_terms",
        "cookie_policy",
        "refund_policy",
        "data_processing",
        "eula",
        "other_legal",
        "not_legal",
        "unknown"
      ]
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^k\\d{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "heading": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ruleHints": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "data_collection",
                "data_sharing",
                "data_retention",
                "tracking_cookies",
                "ai_training",
                "auto_renewal",
                "cancellation",
                "refunds",
                "price_changes",
                "unilateral_changes",
                "termination_suspension",
                "liability_limitation",
                "indemnification",
                "arbitration_class_waiver",
                "jurisdiction",
                "content_license",
                "warranty_disclaimer",
                "other"
              ]
            }
          }
        },
        "required": [
          "id",
          "text",
          "heading",
          "start",
          "end",
          "ruleHints"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "url",
    "title",
    "documentTypeHint",
    "language",
    "candidates"
  ],
  "additionalProperties": false
}