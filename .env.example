# ContractLens backend configuration. Copy to .env and fill in your own values.
# NEVER commit .env. The extension never sees these values.

# Primary provider. openai = any OpenAI-compatible API (Groq, Gemini, OpenAI, local Ollama…),
# anthropic = Anthropic Messages API (needs API credit; separate from a Claude Pro subscription),
# none = rule-based mode only.
LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Pick a chat model your key can use: run `npm run diagnose` (it lists available models on 404).
OPENAI_MODEL=openai/gpt-oss-20b

# Optional fallback provider (OpenAI-compatible), used automatically when the primary is
# rate-limited, unavailable or misconfigured. Example: Google Gemini's OpenAI-compatible endpoint.
# FALLBACK_API_KEY=your-gemini-key-here
# FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# FALLBACK_MODEL=gemini-model-name-from-google-ai-studio
# Example: local Ollama (no key needed, use any non-empty value):
# FALLBACK_API_KEY=ollama
# FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
# FALLBACK_MODEL=qwen2.5:7b

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5

HOST=127.0.0.1
PORT=8787
# Exact origins allowed to call the backend. Replace * with your extension id in production.
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:4173,http://127.0.0.1:4173
RATE_LIMIT_PER_MINUTE=30
# Lets the optional Page Agent section locator use the LLM through /v1/agent (opt-in in the popup settings).
ENABLE_AGENT_PROXY=true
FORCE_DEMO=false
