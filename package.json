{
  "name": "contractlens",
  "version": "1.0.0",
  "description": "ContractLens — evidence-grounded risk analysis of Terms of Service and Privacy Policies (Chrome MV3 extension).",
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:extension": "node scripts/build.mjs extension",
    "build:harness": "node scripts/build.mjs harness",
    "backend": "tsx src/backend/index.ts",
    "harness": "node scripts/serve-harness.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "schema:export": "tsx scripts/export-schema.ts",
    "eval": "tsx eval/run-eval.ts",
    "eval:score": "tsx eval/score-eval.ts",
    "eval:fetch": "tsx eval/fetch-sources.ts",
    "cy:run": "cypress run --browser electron",
    "cy:open": "cypress open",
    "e2e": "npm run build:harness && node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "smoke:extension": "node scripts/extension-smoke.mjs",
    "smoke:extension-llm": "node scripts/extension-smoke-llm.mjs",
    "record:demo": "npm run build:harness && node scripts/record-demo.mjs",
    "eval:validate": "tsx eval/validate-annotations.ts",
    "diagnose": "tsx scripts/diagnose-llm.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@page-agent/core": "1.12.4",
    "@page-agent/page-controller": "1.12.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "cypress": "^15.21.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "marked": "^15.0.12",
    "playwright": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
